{
  "name": "foodresq-network",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "create-admin": "npm run create-admin --workspace server",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
